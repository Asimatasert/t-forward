#!/bin/bash
# fake ss -tln: lists every port in $FAKE_STATE/listening
FS=${FAKE_STATE:?FAKE_STATE not set}
echo "State  Recv-Q Send-Q Local Address:Port Peer Address:Port"
[ -f "$FS/listening" ] || exit 0
while read -r p; do
    [ -n "$p" ] && echo "LISTEN 0      4096   ${FAKE_ETH_IP:-172.17.0.2}:$p 0.0.0.0:*"
done <"$FS/listening"
exit 0
